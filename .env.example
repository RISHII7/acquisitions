# =================================
# ACQUISITIONS API - Environment Configuration
# =================================
# Copy this file to .env.development or .env.production and fill in your values

# =================================
# Node.js Environment Settings
# =================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# =================================
# Database Configuration
# =================================
# For development (using Neon Local with Docker):
DATABASE_URL=postgres://neon:npg@localhost:5432/neondb?sslmode=require
DATABASE_NAME=neondb

# For production (direct Neon Cloud connection):
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require&channel_binding=require

# =================================
# Neon Database Configuration
# =================================
# Get these values from your Neon Console (https://console.neon.tech)
# Required for development with Neon Local
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=your_parent_branch_id_here
DELETE_BRANCH=true

# =================================
# Security & Authentication
# =================================
# JWT Secret - Use a strong, random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here

# Arcjet API Key for security features (bot protection, rate limiting)
# Get from: https://app.arcjet.com
ARCJET_KEY=your_arcjet_api_key_here

# =================================
# CORS Configuration (Production)
# =================================
# Specify allowed origins for CORS (production only)
# CORS_ORIGIN=https://yourdomain.com

# =================================
# How to get required API keys:
# =================================

# 1. NEON DATABASE:
#    - Sign up at https://neon.tech
#    - Create a new project
#    - Go to Settings -> General -> Project ID (copy this)
#    - Go to Settings -> General -> API Keys -> Create new key
#    - For PARENT_BRANCH_ID, use your main branch ID (usually starts with br-)

# 2. ARCJET SECURITY:
#    - Sign up at https://arcjet.com
#    - Create a new application
#    - Copy your API key from the dashboard

# 3. JWT SECRET:
#    - Generate a secure random string (32+ characters)
#    - You can use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    - Or online tools like: https://generate-random.org/api-key-generator

# =================================
# Development vs Production Notes:
# =================================

# DEVELOPMENT:
# - Uses Neon Local proxy running in Docker
# - Database runs on localhost:5432
# - Hot reload enabled
# - Debug logging
# - Requires NEON_API_KEY, NEON_PROJECT_ID, PARENT_BRANCH_ID

# PRODUCTION:
# - Direct connection to Neon Cloud
# - Uses production DATABASE_URL
# - Info-level logging
# - Optimized for performance
# - Does NOT need NEON_API_KEY or NEON_PROJECT_ID